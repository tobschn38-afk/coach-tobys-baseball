{
  "appId": "de.coachtoby.baseball",
  "appName": "Coach Tobys Baseball App",
  "webDir": "www",
  "backgroundColor": "#1f2e24",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#1f2e24",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1f2e24",
      "overlaysWebView": false
    }
  }
}
